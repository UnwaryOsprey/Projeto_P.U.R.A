# Cada nó só publica no próprio tópico e só lê o próprio comando.
# Ajuste "casa1" e os cômodos conforme PURA_HOUSE / PURA_ROOMS.
user pura-server
topic read  pura/casa1/#
topic write pura/casa1/+/atuador/cmd
topic write pura/casa1/server/status

user esp32-sala
topic write pura/casa1/sala/sensor
topic write pura/casa1/sala/status
topic write pura/casa1/sala/atuador/state
topic read  pura/casa1/sala/atuador/cmd

user esp32-quarto
topic write pura/casa1/quarto/sensor
topic write pura/casa1/quarto/status
topic write pura/casa1/quarto/atuador/state
topic read  pura/casa1/quarto/atuador/cmd
