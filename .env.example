# =============================================================================
# P.U.R.A. - configuracao (todas as linhas sao opcionais no modo local)
#   Copie para ".env" (o iniciar.bat / iniciar.sh ja faz isso sozinho).
#   Nunca faca commit do .env.
# =============================================================================

# --- Casa e comodos -----------------------------------------------------------
# Formato dos comodos: nome:volume_m3[:bedroom], separados por virgula.
# "bedroom" ativa a janela de sono (22h-7h, hora local) com limite de ruido.
PURA_HOUSE=casa1
PURA_ROOMS=sala:40,quarto:25:bedroom

# --- Chaves de assinatura das mensagens (HMAC-SHA256) -------------------------
# Modo local: pode deixar em branco (o programa gera chaves aleatorias a cada execucao).
# Modo --mqtt (ESP32 real): obrigatorio. Uma chave por comodo, IGUAL ao HMAC_KEY do firmware.
# Gere uma chave com:   python -c "import secrets; print(secrets.token_hex(16))"
# Exemplo:  PURA_KEYS=sala=3f9c...,quarto=a81d...
PURA_KEYS=

# --- Otimizacao e ciclo de decisao --------------------------------------------
# Estrategia: fuzzy | hysteresis | timer | ga | sa   (tambem trocavel pelo painel)
PURA_OPTIMIZER=fuzzy
# Intervalo entre decisoes (s). Producao: 900.  Demonstracao: 10.
PURA_CYCLE_S=10
# Tempo minimo que um atuador fica ligado antes de poder mudar (s). Producao: 600.
PURA_MIN_RUN_S=30
# Reenvio periodico do comando vigente ao no (s).
PURA_HEARTBEAT_S=60
# Sem leitura valida por este tempo => comodo "sem dados" e modo seguro (s). Producao: 180.
PURA_STALE_S=60
# Tolerancia de diferenca de relogio ao validar assinaturas (s).
PURA_MAX_SKEW_S=120

# --- Painel / API -------------------------------------------------------------
PURA_API_PORT=8000
# Token exigido no header X-API-Token do POST /api/optimizer. Vazio = aberto
# (ok para uso local em 127.0.0.1).
PURA_API_TOKEN=

# --- Simulador local (ESP32 virtual) ------------------------------------------
# Aceleracao do tempo simulado (1 = tempo real)
PURA_SIM_SPEED=30
# Periodo de publicacao das leituras (s)
PURA_SIM_PERIOD_S=2
# Semente do cenario (reprodutibilidade)
PURA_SIM_SEED=0

# --- Broker MQTT: so para o modo --mqtt (ESP32 reais) -------------------------
# Instale o Mosquitto no Windows (veja docs/esp32-real.md).
PURA_MQTT_HOST=localhost
PURA_MQTT_PORT=1883
# PURA_MQTT_USER=
# PURA_MQTT_PASSWORD=
