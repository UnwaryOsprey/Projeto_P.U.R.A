# =============================================================================
# P.U.R.A. — variáveis de ambiente
#   cp .env.example .env   e ajuste os valores.
#   NUNCA faça commit do .env (já está no .gitignore).
# Lido por: src/pura/config.py (servidor + simulador) e docker-compose.yml
# =============================================================================

# --- Casa e cômodos -----------------------------------------------------------
# PURA_HOUSE entra nos tópicos MQTT: pura/<casa>/<comodo>/...
# Se mudar, atualize também infra/mosquitto/acl e o firmware (config.h).
PURA_HOUSE=casa1
# Formato: nome:volume_m3[:bedroom], separados por vírgula.
# "bedroom" ativa a janela de sono (22h–7h, hora local) com limite de ruído.
PURA_ROOMS=sala:40,quarto:25:bedroom

# --- Segurança das mensagens (HMAC-SHA256) ------------------------------------
# Uma chave por cômodo, formato: comodo=chave,comodo=chave
# Gere cada uma com:  openssl rand -hex 16
# Devem ser IGUAIS ao HMAC_KEY do firmware daquele cômodo.
# Cômodo sem chave aqui cai numa chave padrão insegura ("dev-only-change-me").
PURA_KEYS=sala=TROQUE_ESTA_CHAVE_SALA,quarto=TROQUE_ESTA_CHAVE_QUARTO

# --- Broker MQTT --------------------------------------------------------------
# Modo DEV (padrão): sem TLS e sem autenticação. Só em rede de laboratório isolada.
# Dentro do docker compose o host é o nome do serviço ("mosquitto");
# rodando fora do Docker use localhost.
PURA_MQTT_HOST=mosquitto
PURA_MQTT_PORT=1883

# Modo SEGURO (TLS + usuário/senha + ACL): comente as duas linhas de cima,
# descomente o bloco abaixo e rode antes infra/gen_certs.sh e infra/create_users.sh.
# PURA_MQTT_PORT=8883
# PURA_MQTT_USER=pura-server
# PURA_MQTT_PASSWORD=senha-gerada-por-create_users.sh
# PURA_MQTT_CA=/certs/ca.crt
# Lido só pelo docker compose (escolhe o arquivo de config do Mosquitto):
# MOSQUITTO_CONF=mosquitto.conf

# --- Otimização e ciclo de decisão --------------------------------------------
# Estratégia: fuzzy | hysteresis | timer | ga | sa  (também trocável pelo painel)
PURA_OPTIMIZER=fuzzy
# Intervalo entre decisões, em segundos. Produção: 900. Testes de bancada: 10.
PURA_CYCLE_S=10
# Tempo mínimo que um atuador fica ligado antes de poder mudar (s). Produção: 600.
PURA_MIN_RUN_S=30
# Reenvio periódico do comando vigente ao nó (s). Mantém o nó fora do fail-safe.
PURA_HEARTBEAT_S=60
# Sem leitura válida por este tempo => cômodo "sem dados" e modo seguro (s). Produção: 180.
PURA_STALE_S=60
# Tolerância de diferença de relógio entre servidor e ESP32 ao validar a assinatura (s).
PURA_MAX_SKEW_S=120

# --- API / painel -------------------------------------------------------------
PURA_API_PORT=8000
# Token exigido no header X-API-Token do POST /api/optimizer.
# Vazio = endpoint aberto (aceitável só em laboratório).  Gere com: openssl rand -hex 24
PURA_API_TOKEN=

# --- Simulador (ESP32 virtual): docker compose --profile sim up ---------------
# Fator de aceleração do tempo simulado
PURA_SIM_SPEED=30
# Período de publicação das leituras (s)
PURA_SIM_PERIOD_S=2
# Semente do cenário (reprodutibilidade)
PURA_SIM_SEED=0
# Senha MQTT dos nós virtuais (só no modo seguro; usuários esp32-<comodo>)
# PURA_SIM_PASSWORD=
